{
  "name": "accessly",
  "version": "0.2.0",
  "description": "Permissions and RBAC for React and Next.js UIs: <Can>, usePermission, feature flags, filtered navigation, and decisions that explain why access was denied.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Mostafa Mohamed Abdalla (https://github.com/Mostafashadow1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mostafashadow1/accessly.git",
    "directory": "packages/accessly"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/Mostafashadow1/accessly/issues"
  },
  "homepage": "https://accessly-website.vercel.app/",
  "keywords": [
    "permissions",
    "authorization",
    "access-control",
    "rbac",
    "roles",
    "feature-flags",
    "protected-route",
    "can",
    "casl-alternative",
    "react",
    "nextjs",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
